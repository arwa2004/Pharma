    :contientExcipient :Exc_Lactose, :Exc_Silice ;
    :aForme :Forme_Gelule ;
    :administreParVoie :Voie_Orale ;
    :appartientAClasse :Classe_InhibiteurPompeProtons ;
    :estFabriquePar :Lab_Unimed .

