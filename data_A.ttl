:Med_Ciprofloxacine a :MedicamentSurOrdonnance ;
    :nomCommercial "Ciprofloxacine Ciflox" ;
    :codeAMM "AMM-3400943-CIPR" ;
    :dosageMg 500.0 ;
    :contientPrincipeActif :Mol_Ciprofloxacine ;
